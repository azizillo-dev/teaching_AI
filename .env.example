# Django Settings
SECRET_KEY=django-insecure-change-this-to-a-real-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
DB_NAME=mentor_ai_db
